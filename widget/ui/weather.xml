<?xml version='1.0' encoding='utf-8'?>
<weather-ui xmlns:android="http://schemas.android.com/apk/res/android">
  <LinearLayout android:id="@+id/weather_forecasts" android:layout_width="wrap_content" android:layout_height="112px" android:orientation="horizontal" android:gravity="top" android:layout_alignParentEnd="true" android:layout_marginEnd="20px" android:clipChildren="false">
    <TextView android:id="@+id/weather_day_label" android:layout_width="wrap_content" android:layout_height="72px" android:text="день" android:textSize="48px" android:lineHeight="72px" android:fontFamily="@string/font_display_permission" android:textFontWeight="500" />
    <TextView android:id="@+id/weather_day" android:layout_width="wrap_content" android:layout_height="72px" android:textSize="48px" android:lineHeight="72px" android:fontFamily="@string/font_display_permission" android:textFontWeight="500" android:maxLines="1" android:layout_marginStart="12px" />
    <ImageView android:id="@+id/weather_day_icon" android:layout_width="56px" android:layout_height="72px" android:layout_marginStart="10px" android:src="@drawable/weather_unknown" android:scaleType="fitCenter" />
    <RelativeLayout android:id="@+id/weather_night_labels" android:layout_width="wrap_content" android:layout_height="112px" android:layout_marginStart="24px">
      <TextView android:id="@+id/weather_night_label" android:layout_width="wrap_content" android:layout_height="72px" android:text="ночь" android:textSize="48px" android:lineHeight="72px" android:layout_alignParentStart="true" android:fontFamily="@string/font_display_permission" android:textFontWeight="500" />
      <TextView android:id="@+id/weather_night" android:layout_width="wrap_content" android:layout_height="72px" android:layout_toEndOf="@id/weather_night_label" android:layout_marginStart="12px" android:textSize="48px" android:lineHeight="72px" android:fontFamily="@string/font_display_permission" android:textFontWeight="500" android:maxLines="1" />
      <ImageView android:id="@+id/weather_night_dates" android:layout_width="0px" android:layout_height="40px" android:layout_below="@id/weather_night_label" android:layout_alignStart="@id/weather_night_label" android:layout_alignEnd="@id/weather_night" android:scaleType="fitXY" />
    </RelativeLayout>
    <ImageView android:id="@+id/weather_night_icon" android:layout_width="56px" android:layout_height="72px" android:layout_marginStart="10px" android:src="@drawable/weather_unknown" android:scaleType="fitCenter" />
  </LinearLayout>
  <LinearLayout android:id="@+id/location_row" android:layout_width="wrap_content" android:layout_height="72px" android:layout_gravity="end" android:layout_marginTop="7px" android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:id="@+id/appwidget_city" android:layout_width="wrap_content" android:layout_height="72px" android:textSize="48px" android:lineHeight="72px" android:fontFamily="@string/font_display_permission" android:textFontWeight="500" android:maxWidth="660px" android:maxLines="1" android:ellipsize="end" android:layout_marginEnd="12px" />
    <ImageView android:id="@+id/weather_settings" android:layout_width="72px" android:layout_height="72px" android:padding="10px" android:src="@drawable/ic_settings" android:contentDescription="Настройки погоды" />
  </LinearLayout>
</weather-ui>