<?xml version='1.0' encoding='utf-8'?>
<weather-ui xmlns:android="http://schemas.android.com/apk/res/android">
  <LinearLayout android:id="@+id/weather_forecasts" android:layout_width="wrap_content" android:layout_height="160px" android:orientation="horizontal" android:layout_alignParentEnd="true" android:layout_marginEnd="20px" android:gravity="top">
    <LinearLayout android:id="@+id/weather_first_card" android:layout_width="264px" android:layout_height="144px" android:orientation="vertical" android:gravity="center_horizontal" android:layout_marginStart="0px">
      <LinearLayout android:layout_width="wrap_content" android:layout_height="88px" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/weather_first_temperature" android:layout_width="wrap_content" android:layout_height="88px" android:gravity="center_vertical" android:includeFontPadding="false" android:textSize="64px" android:fontFamily="@string/font_display_permission" android:maxLines="1" />
        <ImageView android:id="@+id/weather_first_icon" android:layout_width="80px" android:layout_height="80px" android:layout_marginStart="12px" android:scaleType="fitCenter" />
      </LinearLayout>
      <ImageView android:id="@+id/weather_first_caption" android:layout_width="264px" android:layout_height="44px" android:scaleType="fitCenter" />
    </LinearLayout>
    <LinearLayout android:id="@+id/weather_second_card" android:layout_width="264px" android:layout_height="144px" android:orientation="vertical" android:gravity="center_horizontal" android:layout_marginStart="24px">
      <LinearLayout android:layout_width="wrap_content" android:layout_height="88px" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/weather_second_temperature" android:layout_width="wrap_content" android:layout_height="88px" android:gravity="center_vertical" android:includeFontPadding="false" android:textSize="64px" android:fontFamily="@string/font_display_permission" android:maxLines="1" />
        <ImageView android:id="@+id/weather_second_icon" android:layout_width="80px" android:layout_height="80px" android:layout_marginStart="12px" android:scaleType="fitCenter" />
      </LinearLayout>
      <ImageView android:id="@+id/weather_second_caption" android:layout_width="264px" android:layout_height="44px" android:scaleType="fitCenter" />
    </LinearLayout>
  </LinearLayout>
  <LinearLayout android:id="@+id/location_row" android:layout_width="wrap_content" android:layout_height="72px" android:layout_gravity="end" android:layout_marginTop="7px" android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:id="@+id/appwidget_city" android:layout_width="wrap_content" android:layout_height="72px" android:textSize="48px" android:lineHeight="72px" android:fontFamily="@string/font_display_permission" android:textFontWeight="500" android:maxWidth="660px" android:maxLines="1" android:ellipsize="end" android:layout_marginEnd="12px" />
    <ImageView android:id="@+id/weather_settings" android:layout_width="72px" android:layout_height="72px" android:padding="10px" android:src="@drawable/ic_settings" android:contentDescription="Настройки погоды" />
  </LinearLayout>
  <LinearLayout android:id="@+id/weather_attribution" android:layout_width="wrap_content" android:layout_height="64px" android:layout_gravity="end" android:layout_marginEnd="16px" android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:id="@+id/weather_credit" android:layout_width="wrap_content" android:layout_height="48px" android:gravity="center_vertical" android:textSize="26px" android:fontFamily="@string/font_display_permission" android:maxLines="1" />
    <ImageView android:id="@+id/weather_website" android:layout_width="48px" android:layout_height="48px" android:padding="9px" android:src="@drawable/ic_open_external" android:contentDescription="Открыть прогноз на сайте источника" />
  </LinearLayout>
</weather-ui>